# FINTRAC Sentinel - configuration
# Copy to .env and adjust. Everything here has a working default; nothing in
# this file is required to run the demo.

# ---- persistence ---------------------------------------------------------
# SQLite by default (zero infrastructure). For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/sentinel
# DATABASE_URL=sqlite:///./data/sentinel.db
# SQL_ECHO=0

# ---- regulatory parameters ----------------------------------------------
# Change these only with a documented reason: they decide when a report is owed.
# LVCTR_THRESHOLD_CAD=10000
# AGGREGATION_WINDOW_HOURS=24
# FILING_DEADLINE_WORKING_DAYS=5
# VALUATION_METHODOLOGY=pricing-v2

# ---- reporting entity ----------------------------------------------------
# These come from the entity's own FINTRAC organisation record and cannot be
# derived. See docs/LEGACY_REPO_ANALYSIS.md section 2.5.
# RE_NUMBER=1234567              # F2R -> Organization -> My Organization
# RE_CONTACT_NUMBER=7654321      # F2R -> Organization -> Users
# RE_LOCATION_REFERENCE=L0000001 # F2R -> Organization -> Location
# RE_ACTIVITY_SECTOR=11          # 11 = money services business
# RE_LEGAL_NAME=Northbound Digital Assets Inc.
# RE_REPORT_PREFIX=NDA-LVCTR

# ---- risk ----------------------------------------------------------------
# CASE_CREATION_SCORE=40         # a case opens at or above this score
# ANOMALY_CONTAMINATION=0.05
# ANOMALY_WEIGHT=12              # max risk points the ML layer can contribute

# ---- security ------------------------------------------------------------
# REQUIRED in any deployment that is not a local demo. Rotate it.
# SECRET_KEY=change-me
# TOKEN_TTL_SECONDS=28800
# AUTH_REQUIRED=1                # 0 disables auth entirely - local dev only

# ---- safety guards -------------------------------------------------------
# Seeding refuses to run unless this is set, because --reset drops tables.
# SYNTHETIC_DATA_ONLY=1
# Submission is refused for any value other than "mock".
# SUBMISSION_ENDPOINT=mock
