# Never commit data or secrets. This file is a convenience, not a control -
# see docs/SECURITY.md.
# Anchored to the repository root. A bare `data/` pattern also matches
# web/src/data/, and Vercel then omits the committed snapshot that
# web/src/lib/snapshot.ts imports.
/data/
*.db
*.db-wal
*.db-shm
.env

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
.vercel/
web/node_modules/
web/.next/
